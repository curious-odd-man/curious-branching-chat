{
  "name": "branchchat",
  "version": "2.0.0",
  "description": "BranchChat — offline-first branching discussions for Windows",
  "private": true,
  "main": "./out/main/index.js",
  "author": "BranchChat",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tests/e2e/tsconfig.json --noEmit && tsc -p tests/renderer/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --win nsis --publish never",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:e2e": "electron-vite build --mode e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.2.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.25",
    "@tiptap/core": "^3.32.2",
    "@tiptap/extension-bold": "^3.32.2",
    "@tiptap/extension-document": "^3.32.2",
    "@tiptap/extension-hard-break": "^3.32.2",
    "@tiptap/extension-heading": "^3.32.2",
    "@tiptap/extension-italic": "^3.32.2",
    "@tiptap/extension-link": "^3.32.2",
    "@tiptap/extension-list": "^3.32.2",
    "@tiptap/extension-paragraph": "^3.32.2",
    "@tiptap/extension-text": "^3.32.2",
    "@tiptap/extension-text-style": "^3.32.2",
    "@tiptap/extension-underline": "^3.32.2",
    "@tiptap/extensions": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.8.11",
    "libsodium-wrappers": "^0.8.4",
    "lodash.isequal": "file:shims/lodash.isequal",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "^14.0.5",
      "minimatch": "^11.0.8"
    },
    "global-agent": "^4.1.7",
    "lodash.isequal": "$lodash.isequal"
  }
}
