<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:id="rootBorderPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="0.0" minWidth="0.0" prefHeight="1080.0" prefWidth="1920.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.github.curiousoddman.curious.chat.ui.controller.screen.LibraryController">
    <top>
        <HBox maxHeight="25.0" prefHeight="25.0" BorderPane.alignment="CENTER">
            <children>
                <MenuBar HBox.hgrow="ALWAYS">
                    <menus>
                        <Menu mnemonicParsing="false" text="File">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#onNewDesign" text="New..." />
                                <MenuItem mnemonicParsing="false" onAction="#onOpenDesign" text="Open..." />
                                <Menu fx:id="recentProjectsMenu" mnemonicParsing="false" text="Recent projects" />
                                <MenuItem mnemonicParsing="false" onAction="#onSave" text="Save" />
                                <MenuItem mnemonicParsing="false" text="Close" />
                            </items>
                        </Menu>
                        <Menu mnemonicParsing="false" text="Help">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#onShowShortcuts" text="Keyboard Shortcuts..." />
                            </items>
                        </Menu>
                    </menus>
                </MenuBar>
                <Button fx:id="notificationsMenu" mnemonicParsing="false" visible="false" />
            </children>
        </HBox>
    </top>
    <bottom>
        <HBox fx:id="backgroundProgressContainer" alignment="CENTER_LEFT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="12.0" visible="false" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="6.0" left="10.0" right="10.0" top="6.0" />
            </padding>
            <Label fx:id="backgroundProcessTitleLabel" maxWidth="1.7976931348623157E308" text="Running: xxxxx" />
            <Button fx:id="backgroundProcessCancelButton" cancelButton="true" mnemonicParsing="false" onAction="#onCancelBackgroundJob" text="❌" textFill="RED">
                <font>
                    <Font size="14.0" />
                </font>
            </Button>
            <StackPane fx:id="backgroundProgressBarContainer">
                <children>
                    <ProgressBar fx:id="backgroundProgressBar" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="400.0" />
                    <Label fx:id="backgroundProgressLabel" contentDisplay="CENTER" styleClass="progress-label-shadow" text="1 of 10" textAlignment="CENTER" textFill="WHITE">
                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>
                    </Label>
                </children>
            </StackPane>
            <Label fx:id="backgroundProgressDescription" maxWidth="1.7976931348623157E308" text="here goes file name" HBox.hgrow="ALWAYS" />
        </HBox>
    </bottom>
    <right>
    </right>
</BorderPane>
