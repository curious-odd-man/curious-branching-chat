<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.github.curiousoddman.curious.chat.preloader.PreloaderController"
        styleClass="preloader-root">

    <!-- HEADER -->
    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="12"
                styleClass="header">

            <Label
                    text="FURNITURE"
                    styleClass="brand-primary"/>

            <Label
                    text="CAD"
                    styleClass="brand-secondary"/>

            <VBox
                    HBox.hgrow="ALWAYS"/>

            <Label
                    text="v1.0.0"
                    styleClass="version"/>

        </HBox>
    </top>


    <!-- CENTER -->
    <center>
        <StackPane>

            <!-- CAD grid -->
            <StackPane fx:id="gridPane"
                       styleClass="cad-grid"/>

            <!-- Furniture model -->
            <VBox
                    alignment="CENTER"
                    spacing="18">

                <StackPane
                        fx:id="modelPane"
                        prefWidth="520"
                        prefHeight="320"
                        maxWidth="520"
                        maxHeight="320"
                        styleClass="model-container"/>

                <Label
                        fx:id="modelStatus"
                        text="INITIALIZING DESIGN ENGINE"
                        styleClass="model-status"/>

            </VBox>

        </StackPane>
    </center>


    <!-- BOTTOM -->
    <bottom>
        <VBox
                spacing="14"
                styleClass="bottom-panel">

            <HBox
                    alignment="CENTER_LEFT">

                <Label
                        fx:id="operationLabel"
                        text="Initializing geometry engine..."
                        styleClass="operation"/>

                <VBox
                        HBox.hgrow="ALWAYS"/>

                <Label
                        fx:id="percentageLabel"
                        text="0%"
                        styleClass="percentage"/>

            </HBox>


            <ProgressBar
                    fx:id="progressBar"
                    prefHeight="4"
                    maxWidth="Infinity"
                    progress="0"
                    styleClass="cad-progress"/>


            <HBox
                    spacing="35"
                    styleClass="steps">

                <VBox fx:id="geometryStep"
                      spacing="4">
                    <Label text="GEOMETRY"
                           styleClass="step-title"/>
                    <Label fx:id="geometryStatus"
                           text="WAITING"
                           styleClass="step-status"/>
                </VBox>

                <VBox fx:id="materialsStep"
                      spacing="4">
                    <Label text="MATERIALS"
                           styleClass="step-title"/>
                    <Label fx:id="materialsStatus"
                           text="WAITING"
                           styleClass="step-status"/>
                </VBox>

                <VBox fx:id="componentsStep"
                      spacing="4">
                    <Label text="COMPONENTS"
                           styleClass="step-title"/>
                    <Label fx:id="componentsStatus"
                           text="WAITING"
                           styleClass="step-status"/>
                </VBox>

                <VBox fx:id="rendererStep"
                      spacing="4">
                    <Label text="RENDERER"
                           styleClass="step-title"/>
                    <Label fx:id="rendererStatus"
                           text="WAITING"
                           styleClass="step-status"/>
                </VBox>

                <VBox fx:id="workspaceStep"
                      spacing="4">
                    <Label text="WORKSPACE"
                           styleClass="step-title"/>
                    <Label fx:id="workspaceStatus"
                           text="WAITING"
                           styleClass="step-status"/>
                </VBox>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>